    family-names: Erb
    orcid: "https://orcid.org/0000-0002-1763-2522"
  - given-names: Julien
    family-names: Emile-Geay
    orcid: "https://orcid.org/0000-0001-5920-4751"
  - given-names: Deborah
    family-names: Khider
    orcid: "https://orcid.org/0000-0001-7501-8430"
repository-code: "https://github.com/DaveEdge1/presto-holocene_da"
url: "https://paleopresto.com"
license: GPL-3.0-only
keywords:
  - paleoclimate
  - data assimilation
  - Holocene
  - climate reconstruction
  - reproducibility
  - LiPD
# After cutting a GitHub release with the Zenodo integration enabled,
# replace the placeholder below with the Zenodo CONCEPT DOI (the one that
# always resolves to the latest version), and set version/date-released.
# version: "1.0.0"
# date-released: "2026-MM-DD"
# identifiers:
#   - type: doi
#     value: 10.5281/zenodo.XXXXXXX
#     description: Concept DOI (always resolves to the latest release)
# The underlying method paper is listed under `references` (not
# `preferred-citation`) so that GitHub's "Cite this repository" button
# credits this software while still pointing users to the paper:
